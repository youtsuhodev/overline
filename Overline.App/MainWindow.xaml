<Window x:Class="Overline.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Overline.App.Controls"
        xmlns:local="clr-namespace:Overline.App"
        Title="{Binding AppTitle}"
        Width="820" Height="580"
        MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        WindowStyle="None">

    <!-- Custom title bar: WindowChrome keeps native resize borders, snapping and drag.
         The caption region is the top 40 px; window control buttons opt back into hit testing. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style x:Key="SwitchText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style x:Key="PreviewCounter" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PreviewNearLimit}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PreviewOverBudget}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OscChipBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding OscError}" Value="True">
                    <Setter Property="Background" Value="#1AFF6B6B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OscOk}" Value="True">
                    <Setter Property="Background" Value="#1A43D17C" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OscDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{StaticResource TextSecondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding OscError}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OscOk}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowButtonClose" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5484D" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== Page templates ===================== -->

        <!-- Dashboard -->
        <DataTemplate x:Key="DashboardTemplate">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Loc[PreviewTitle]}" />
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource PreviewCounter}"
                                       Text="{Binding PreviewCounterText}" />
                        </Grid>
                        <ProgressBar Maximum="144" Value="{Binding PreviewLength}" Margin="0,0,0,8" />
                        <Border Background="{StaticResource TrackBackground}" CornerRadius="6" Padding="12,10">
                            <TextBlock Text="{Binding PreviewLine}" FontSize="14"
                                       Foreground="{StaticResource TextPrimary}"
                                       TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0"
                                   Text="{Binding Loc[PreviewHint]}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding StartStopCommand}" Padding="18,9">
                        <TextBlock Text="{Binding StartStopText}" />
                    </Button>
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource BodyText}" Text="{Binding StatusText}" />
                    <Border Grid.Column="2" Style="{StaticResource OscChipBorder}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource OscDot}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding OscStatusText}" FontSize="11"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- Modules -->
        <DataTemplate x:Key="ModulesTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Loc[ModulesTitle]}" Margin="0,4,0,10" />

                    <!-- Time module card -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🕐" FontSize="18"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SwitchText}" FontWeight="SemiBold"
                                           Text="{Binding Loc[TimeName]}" />
                                <controls:StatusPill Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0"
                                                     State="{Binding TimeModulePillState}"
                                                     Text="{Binding TimeModuleStateText}" />
                                <ToggleButton Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding TimeModuleEnabled}" />
                            </Grid>
                            <TextBlock Style="{StaticResource BodyText}" Margin="26,6,0,0"
                                       Text="{Binding Loc[TimeDescription]}" TextWrapping="Wrap" />

                            <StackPanel Margin="26,10,0,0" IsEnabled="{Binding TimeModuleEnabled}">
                                <CheckBox Style="{StaticResource SettingCheck}" Tag="time"
                                          Checked="SettingsCheckChanged" Unchecked="SettingsCheckChanged"
                                          IsChecked="{Binding TimeSettings.ShowDate}" Content="{Binding Loc[SettingsShowDate]}" />
                                <CheckBox Style="{StaticResource SettingCheck}" Tag="time"
                                          Checked="SettingsCheckChanged" Unchecked="SettingsCheckChanged"
                                          IsChecked="{Binding TimeSettings.ShowEmoji}" Content="{Binding Loc[SettingsShowClockEmoji]}" />
                                <CheckBox Style="{StaticResource SettingCheck}" Tag="time"
                                          Checked="SettingsCheckChanged" Unchecked="SettingsCheckChanged"
                                          IsChecked="{Binding TimeSettings.ShowTimeZone}" Content="{Binding Loc[SettingsShowTimeZone]}" />
                                <CheckBox Style="{StaticResource SettingCheck}" Tag="time"
                                          Checked="SettingsCheckChanged" Unchecked="SettingsCheckChanged"
                                          IsChecked="{Binding TimeSettings.Use24Hour}" Content="{Binding Loc[SettingsUse24Hour]}" />
                                <CheckBox Style="{StaticResource SettingCheck}" Tag="time"
                                          Checked="SettingsCheckChanged" Unchecked="SettingsCheckChanged"
                                          IsChecked="{Binding TimeSettings.ShowSeconds}" Content="{Binding Loc[SettingsShowSeconds]}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Media module card -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🎵" FontSize="18"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SwitchText}" FontWeight="SemiBold"
                                           Text="{Binding Loc[MediaName]}" />
                                <controls:StatusPill Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0"
                                                     State="{Binding MediaModulePillState}"
                                                     Text="{Binding MediaModuleStateText}" />
                                <ToggleButton Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding MediaModuleEnabled}" />
                            </Grid>
                            <TextBlock Style="{StaticResource BodyText}" Margin="26,6,0,0"
                                       Text="{Binding Loc[MediaDescription]}" TextWrapping="Wrap" />
                            <TextBlock Margin="26,8,0,0" Text="{Binding Loc[ConsentMissingHint]}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MediaConsentMissing}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Margin="26,10,0,0" IsEnabled="{Binding MediaModuleEnabled}">
                                <CheckBox Style="{StaticResource SettingCheck}" Tag="media"
                                          Checked="SettingsCheckChanged" Unchecked="SettingsCheckChanged"
                                          IsChecked="{Binding MediaSettings.ShowEmoji}" Content="{Binding Loc[SettingsShowMusicEmoji]}" />
                                <CheckBox Style="{StaticResource SettingCheck}" Tag="media"
                                          Checked="SettingsCheckChanged" Unchecked="SettingsCheckChanged"
                                          IsChecked="{Binding MediaSettings.ShowTitle}" Content="{Binding Loc[SettingsShowTitle]}" />
                                <CheckBox Style="{StaticResource SettingCheck}" Tag="media"
                                          Checked="SettingsCheckChanged" Unchecked="SettingsCheckChanged"
                                          IsChecked="{Binding MediaSettings.ShowArtist}" Content="{Binding Loc[SettingsShowArtist]}" />
                                <CheckBox Style="{StaticResource SettingCheck}" Tag="media"
                                          Checked="SettingsCheckChanged" Unchecked="SettingsCheckChanged"
                                          IsChecked="{Binding MediaSettings.ShowTime}" Content="{Binding Loc[SettingsShowTime]}" />
                                <CheckBox Style="{StaticResource SettingCheck}" Tag="media"
                                          Checked="SettingsCheckChanged" Unchecked="SettingsCheckChanged"
                                          IsChecked="{Binding MediaSettings.ShowProgressBar}" Content="{Binding Loc[SettingsShowProgressBar]}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- Privacy -->
        <DataTemplate x:Key="PrivacyTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Loc[PrivacyTitle]}" Margin="0,4,0,10" />
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,12" TextWrapping="Wrap"
                                       Text="{Binding Loc[PrivacyDescription]}" />
                            <Border Background="{StaticResource TrackBackground}" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🎵" FontSize="18"
                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SwitchText}" FontWeight="SemiBold"
                                                   Text="{Binding Loc[MediaConsentTitle]}" />
                                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                                   Text="{Binding Loc[MediaConsentDescription]}" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="2" Style="{StaticResource ToggleSwitch}" Margin="12,0,0,0"
                                                  VerticalAlignment="Center" IsChecked="{Binding MediaConsent}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- Settings -->
        <DataTemplate x:Key="SettingsTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Loc[SettingsTitle]}" Margin="0,4,0,10" />
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource SwitchText}" VerticalAlignment="Center"
                                           Text="{Binding Loc[LanguageLabel]}" Margin="0,0,20,0" />
                                <ComboBox Grid.Column="1" Width="140" HorizontalAlignment="Left"
                                          SelectedIndex="{Binding LanguageIndex}">
                                    <ComboBoxItem Content="Auto" />
                                    <ComboBoxItem Content="English" />
                                    <ComboBoxItem Content="Français" />
                                </ComboBox>
                            </Grid>
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0"
                                       Text="{Binding Loc[LanguageHint]}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Loc[AboutTitle]}" />
                            <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                       Text="{Binding Loc[AboutDescription]}" />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0"
                                       Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"
                                       Text="Overline v0.1.0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== Custom title bar ===================== -->
        <Grid Grid.Row="0" Background="{StaticResource CardBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image Source="/Assets/logo.png" Width="18" Height="18" Margin="0,0,8,0" />
                <TextBlock Text="Overline" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource WindowButton}" Click="Minimize_Click"
                        ToolTip="{Binding Loc[WindowMinimize]}">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
                <Button Style="{StaticResource WindowButton}" Click="MaximizeRestore_Click"
                        ToolTip="{Binding Loc[WindowMaximize]}">
                    <Grid>
                        <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="Maximized">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="&#xE923;" FontFamily="Segoe MDL2 Assets" FontSize="10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="Maximized">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>
                <Button Style="{StaticResource WindowButtonClose}" Click="Close_Click"
                        ToolTip="{Binding Loc[WindowClose]}">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===================== Body ===================== -->
        <Grid Grid.Row="1" Margin="14,4,14,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Sidebar ===================== -->
        <Border Grid.Column="0" Background="{StaticResource CardBackground}" CornerRadius="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,16,16,16">
                    <Image Source="/Assets/logo.png" Width="32" Height="32" Margin="0,0,9,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Overline" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="{Binding HeaderSubtitle}" FontSize="10.5"
                                   Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="16,12,16,14"
                        Background="{StaticResource TrackBackground}" CornerRadius="8" Padding="10,6">
                    <TextBlock Text="v0.1.0 · OSC 9000" FontSize="10.5"
                               Foreground="{StaticResource TextSecondary}" TextAlignment="Center" />
                </Border>

                <ListBox ItemsSource="{Binding NavItems}"
                         SelectedValue="{Binding CurrentPage}" SelectedValuePath="Page"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Margin="10,0,10,8">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource SidebarItem}" />
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,9,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===================== Content ===================== -->
        <!--
            Content stays bound to the ViewModel so page templates keep the VM as
            DataContext (binding Content to the AppPage enum would replace it and
            break every binding inside the templates). Page switching happens
            through the ContentTemplate triggers below.
        -->
        <ContentControl Grid.Column="1" Margin="14,0,0,0">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Content" Value="{Binding}" />
                    <Setter Property="ContentTemplate" Value="{StaticResource DashboardTemplate}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:AppPage.Modules}">
                            <Setter Property="ContentTemplate" Value="{StaticResource ModulesTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:AppPage.Privacy}">
                            <Setter Property="ContentTemplate" Value="{StaticResource PrivacyTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:AppPage.Settings}">
                            <Setter Property="ContentTemplate" Value="{StaticResource SettingsTemplate}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
        </Grid>
    </Grid>
</Window>