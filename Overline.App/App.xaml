<Application x:Class="Overline.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFF" />
        <SolidColorBrush x:Key="WindowBackground" Color="#1B1523" />
        <SolidColorBrush x:Key="CardBackground" Color="#241C30" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F2EEF7" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9C93AC" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Application.Resources>
</Application>
